<?xml version="1.0" encoding="utf-8"?>
<!--
  The Glance port of prayer_widget_small_info.xml: the same sizes, cells, preview and
  settings screen, so the two can be placed side by side and compared.
  Only the initial layout differs: Glance's loading view until the
  first composition lands.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.prayer_times.PrayerWidgetConfigureActivity"
    android:description="@string/widget_description_small"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/prayer_widget_small_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetFeatures="reconfigurable"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:maxResizeWidth="300dp"
    android:maxResizeHeight="160dp" />
