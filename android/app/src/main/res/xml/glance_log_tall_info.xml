<?xml version="1.0" encoding="utf-8"?>
<!--
  The Glance port of prayer_widget_log_tall_info.xml: the same sizes, cells, preview and
  settings screen, so the two can be placed side by side and compared.
  Only the initial layout differs: Glance's loading view until the
  first composition lands.
-->
<!--
  minHeight is the shortest card that draws the practice graph:
  LOG_CHROME_ROOMY_DP (162) + GRID_MIN_BOX_DP (36), LogGlanceWidget. A launcher places targetCellHeight (2) only when two of its rows
  are at least that tall; where they are shorter — a dense grid, small
  cells — it places as many rows as minHeight needs instead, so the tall
  entry always arrives with its graph.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.prayer_times.PrayerWidgetConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:description="@string/widget_description_log_tall"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="198dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/prayer_widget_log_tall_preview"
    android:resizeMode="horizontal"
    android:minResizeWidth="250dp"
    android:maxResizeWidth="600dp"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:targetCellWidth="4"
    android:targetCellHeight="2" />
