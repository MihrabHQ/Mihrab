<?xml version="1.0" encoding="utf-8"?>
<!--
  The picker preview — static, because the picker never runs the provider
  and the real layout starts with its content `gone`.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:background="@drawable/widget_card_preview"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_reading_header"
            android:textColor="#9AA0A6"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_preview_reading_surah"
            android:textColor="#E8EAED"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_reading_position"
            android:textColor="#9AA0A6"
            android:textSize="11sp"
            android:maxLines="1" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/widget_preview_reading_progress"
            android:textColor="#9AA0A6"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- The play disc, between the two columns as the placed card draws it
         (ReadingGlanceWidget): the preview left it out, so the picker showed
         a card with no button on it. -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_play_button">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_play"
            android:tint="#6BC98A"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="96dp"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_reading_today_portion"
            android:textColor="#9AA0A6"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="4 / 7"
            android:textColor="#E8EAED"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_reading_note"
            android:textColor="#6BC98A"
            android:textSize="10sp"
            android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
