<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_configure_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/widget_configure_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/widget_configure_title" />

    <ScrollView
        android:id="@+id/widget_configure_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_configure_background"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:id="@+id/widget_configure_opacity_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <SeekBar
                android:id="@+id/widget_configure_opacity_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/widget_configure_highlight"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <RadioGroup
                android:id="@+id/widget_configure_highlight_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- Dynamic (phone accent) was removed on 2026-08-27 by
                     request: the widget takes the colour that was chosen for
                     it, never the wallpaper's. See PrayerWidgetProvider. -->

                <RadioButton
                    android:id="@+id/widget_configure_highlight_green"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_highlight_green" />

                <RadioButton
                    android:id="@+id/widget_configure_highlight_teal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_highlight_teal" />

                <RadioButton
                    android:id="@+id/widget_configure_highlight_blue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_highlight_blue" />

                <RadioButton
                    android:id="@+id/widget_configure_highlight_amber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_highlight_amber" />

                <RadioButton
                    android:id="@+id/widget_configure_highlight_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_highlight_custom" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/widget_configure_hex_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/widget_configure_hex_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/widget_configure_hex_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- The accent hint said "Choose Dynamic to follow your phone
                 accent colour". There is no Dynamic to choose any more, and
                 a hint pointing at a control that is gone is worse than no
                 hint, so it went with the radio button. -->

            <!-- The text colour is common: every widget draws its text in it,
                 so this block is outside the prayer-times section below. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/widget_configure_text_color"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <RadioGroup
                android:id="@+id/widget_configure_text_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/widget_configure_text_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_text_light" />

                <RadioButton
                    android:id="@+id/widget_configure_text_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_text_white" />

                <RadioButton
                    android:id="@+id/widget_configure_text_cream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_text_cream" />

                <RadioButton
                    android:id="@+id/widget_configure_text_gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_text_gold" />

                <RadioButton
                    android:id="@+id/widget_configure_text_sky"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_text_sky" />

                <RadioButton
                    android:id="@+id/widget_configure_text_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_text_dark" />

                <RadioButton
                    android:id="@+id/widget_configure_text_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_highlight_custom" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/widget_configure_text_hex_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/widget_configure_hex_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/widget_configure_text_hex_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>


            <!-- Only the prayer-times widgets (Next prayer, Prayer times,
                 Prayer times tall) read these; the activity shows the
                 section only when it was opened from one of them. -->
            <LinearLayout
                android:id="@+id/widget_configure_prayer_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_prayer_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_configure_prayer_note"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/widget_configure_show_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/widget_configure_show_location" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/widget_configure_show_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_show_countdown" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/widget_configure_show_table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_configure_show_table" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/widget_configure_time_size"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/widget_configure_time_size_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <SeekBar
                    android:id="@+id/widget_configure_time_size_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="7" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/widget_configure_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/widget_configure_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
