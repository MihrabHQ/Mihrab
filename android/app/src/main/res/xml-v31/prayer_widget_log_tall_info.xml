<?xml version="1.0" encoding="utf-8"?>
<!--
  Log Today, tall — the second picker entry for the same widget.

  `PrayerWidgetLogLargeProvider` is `PrayerWidgetLogProvider` under another
  name; every layout decision this widget makes it makes from the measured
  height, so an instance placed from here is the same card, two rows tall
  from the start. See prayer_widget_tall_info.xml for why one widget needs
  two entries.

  TWO ROWS, not three. It was three because three rows is ~321dp at 420dpi,
  past the 265dp where the practice graph appears, and the graph was taken
  to be what someone choosing this entry was choosing. Two rows is past
  COMPACT_MAX_HEIGHT_DP on any grid — the date line is back and the chips
  are at full height, which is the difference from the short entry — and on
  a 1080x2400 phone two rows is ~294dp, so the graph comes with them there
  as well. See prayer_widget_tall_info.xml on why a launcher row is not a
  fixed number of dp.
-->
<!-- TWO ROWS IN THE PICKER, NOT ONE — issue #31.

     `targetCellWidth`/`targetCellHeight` are API 31 and say 4x2, and on a
     launcher that honours them this entry previews at twice the height of
     the short one. Not every launcher does. EMUI falls back to
     minWidth/minHeight, and both providers advertised 250x60 — so the
     picker showed two 4x1 tiles with almost the same label, which is
     exactly what was reported: "duplicate widgets (4x1) in the choices".

     `minHeight` is the size the picker PLACES it at; `minResizeHeight` is
     how small it may then be dragged. Separating the two is what this
     entry always meant: place it tall, shrink it if you want the strip.
-->
<!--
  The API 31+ copy: identical to ../xml/prayer_widget_log_tall_info.xml, but hidden from the picker.
  The Glance card of the same name is the entry now; this provider stays
  registered only so widgets a user placed before the switch keep drawing
  (docs/rewrite-plan.md, 4.3). Delete with the provider, once nobody has one placed.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.prayer_times.PrayerWidgetConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional|hide_from_picker"
    android:description="@string/widget_description_log_tall"
    android:initialLayout="@layout/prayer_widget_log"
    android:minWidth="250dp"
    android:minHeight="130dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/prayer_widget_log_tall_preview"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="250dp"
    android:minResizeHeight="60dp"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="600dp" />
