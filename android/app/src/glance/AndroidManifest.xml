<?xml version="1.0" encoding="utf-8"?>
<!--
  The Glance widgets' receivers (docs/rewrite-plan.md, Phase 4): the picker's
  entries. Merged into the app unless it is built with
  -PmihrabGlanceWidgets=false (android/app/build.gradle wires this file in as
  the build types' manifest).

  The RemoteViews providers in src/main/AndroidManifest.xml stay registered,
  hidden from the picker on Android 12+ (res/xml-v31), so widgets placed
  before the switch keep working.

  Only APPWIDGET_UPDATE here. Boot, unlock, the prayer-boundary alarm and the
  app's payload write all reach PrayerWidgetProvider, whose fan-out redraws
  these through GlanceWidgetHook — one fan-out, as the comment on
  USER_PRESENT in the main manifest asks.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
      android:name="com.prayer_times.glance.HijriGlanceReceiver"
      android:exported="true"
      android:label="@string/widget_name_hijri">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/glance_hijri_info" />
    </receiver>
    <receiver
