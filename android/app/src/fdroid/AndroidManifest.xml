<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- "My location" kept up while the app is closed: optional, asked for
         only from Settings → Location, after the app has said what it is
         for (BackgroundLocation.kt). Declared per flavor; Google Play's
         build declares it too (src/play), and needs the Play Console's
         background-location declaration filed before an upload. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
</manifest>
