# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

# THE MAC BUILDS REACT FROM SOURCE (React Native 0.87 on).
#
# Since 0.84 React Native links a prebuilt React.framework (and a prebuilt
# ReactNativeDependencies) by default. Its Mac Catalyst slice builds, runs
# and cannot be signed: codesign refuses the Mac bundle with "bundle format
# is ambiguous (could be app or framework)" — reported upstream against
# 0.84, still so in 0.87.1 — so no Mac release could be notarised. Built
# from source, React is compiled into the app as it was through 0.83, the
# way every Mac release so far was signed. Only under MIHRAB_CATALYST, which
# scripts/build-catalyst.sh sets for its own `pod install`: iOS keeps the
# prebuilt core and its shorter build. React Native reads these two in
# `use_react_native!` and keeps an explicit '0'.
if ENV['MIHRAB_CATALYST'] == '1'
  ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
  ENV['RCT_USE_RN_DEP'] = '0'
end

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# The app's own minimum, mirrored from PrayerApp.xcodeproj. Pods that pin
# something older are raised to it in post_install.
app_min_ios = '15.1'

# THE MAC'S MINIMUM IS READ OFF THE iOS ONE, and 15.1 cannot be read.
#
# A Mac Catalyst build has no macOS deployment target of its own: Xcode
# derives it from IPHONEOS_DEPLOYMENT_TARGET through the SDK's iOS-to-
# Catalyst version map (SDKSettings.json, `iOSMac_macOS`). That map has
# 15.0 → 12.0 and 15.2 → 12.1 and no 15.1 at all, so every target at 15.1
# fell back to the Catalyst minimum, iOS 13.1 = macOS 10.15. Xcode 26
# allowed 10.15; Xcode 27 refuses anything below 12.0, and 105 targets
# failed before compiling a line — which setting MACOSX_DEPLOYMENT_TARGET,
# anywhere, could never fix, because it is not the setting Xcode reads.
#
# So Catalyst builds say 15.2 (macOS 12.1), and only Catalyst builds: the
# `[sdk=macosx*]` condition leaves iOS at 15.1. The same condition is on
# the app target in PrayerApp.xcodeproj; __tests__/catalystDeploymentTarget
# holds both. Found in the rewrite plan's step 5.1 (2026-09-29).
catalyst_min_ios = '15.2'

target 'PrayerApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # Mac Catalyst (Path B, v2.7.38) is OPT-IN via MIHRAB_CATALYST=1 —
    # scripts/build-catalyst.sh sets it before its own `pod install`.
    # It must NOT be on by default: with it enabled, hermes-engine's
    # framework layout changes and the plain iOS DEVICE ARCHIVE dies on
    # Xcode Cloud with "hermesvm.xcframework/ios-arm64: No such file"
    # (build 422, 2026-07-16). Local sim + Catalyst builds don't hit the
    # archive path, which is why this slipped through.
    mihrab_catalyst = ENV['MIHRAB_CATALYST'] == '1'
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => mihrab_catalyst,
      # :ccache_enabled => true
    )

    if mihrab_catalyst
      # Every third-party pod must also opt into Catalyst — the RN helper
      # above only covers the React pods.
      installer.pods_project.targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['SUPPORTS_MACCATALYST'] = 'YES'
          config.build_settings['DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER'] = 'YES'
        end
      end
    end

    # fmt 11 + Apple Clang: upstream only disables consteval for old Apple clang; Xcode 16+ hits
    # __cpp_consteval and sets FMT_USE_CONSTEVAL 1 → Apple Clang compile errors. Insert a catch-all
    # Apple branch before __cpp_consteval. Use a regex: vendored fmt uses "# define" (one space) while
    # some trees use "#  define" — exact-string needles fail on Xcode Cloud (fresh pod checkout).
    fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      contents = File.read(fmt_base).gsub("\r\n", "\n")
      unless contents.include?('PRAYERAPP_APPLE_CONSTEVAL_OFF')
        insert = <<~'INS'.strip
// PRAYERAPP_APPLE_CONSTEVAL_OFF — ios/Podfile (Apple clang / fmt 11, all Xcode versions).
#elif defined(__apple_build_version__)
# define FMT_USE_CONSTEVAL 0
INS
        re = %r{
          (\#\s*elif\s+FMT_MSC_VERSION\s+&&\s+FMT_MSC_VERSION\s+<\s+1929\s*\n
           \#\s*define\s+FMT_USE_CONSTEVAL\s+0[^\n]*\n)
          (\#\s*elif\s+defined\(__cpp_consteval\)\s*\n
           \#\s*define\s+FMT_USE_CONSTEVAL\s+1\s*\n)
        }x
        patched = contents.sub(re) { "#{$1}#{insert}\n#{$2}" }
        if patched != contents
          File.chmod(0o644, fmt_base)
          File.write(fmt_base, patched)
        else
          Pod::UI.warn 'PrayerApp: fmt base.h patch skipped (unexpected upstream layout).'
        end
      end
    end

    # Xcode 16+/26: Clang/Swift "explicit modules" + dependency scanning expects
    # .modulemap under DerivedData before some Pod targets have built — breaks
    # AsyncStorage, RNIap, RCTSwiftUI, etc. (same on device and simulator.)
    installer.pods_project.build_configurations.each do |cfg|
      cfg.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
      cfg.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        cfg.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
        cfg.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
        # Xcode 15+ / 26: allow non-modular includes in framework modules (React Native Pods).
        cfg.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        # fmt 11 + Apple Clang (Xcode 16+): consteval format_string fails; base.h overrides -D flags.
        if target.name == 'fmt'
          defs = cfg.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
          defs = [defs] if defs.is_a?(String)
          defs = defs.is_a?(Array) ? defs : ['$(inherited)']
          defs << 'FMT_USE_CONSTEVAL=0' unless defs.any? { |d| d.to_s.include?('FMT_USE_CONSTEVAL') }
          cfg.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
        end
        # A pod that pins an older minimum than the app warns on every build
        # ("deployment target 11.0, but the range of supported versions is
        # 12.0 to 26.5.99" — react-native-blob-util's privacy-info target).
        # The app is 15.1, nothing can run below that, and a pod claiming
        # otherwise only produces warnings — so raise anything that is lower.
        pod_min = cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_s
        if !pod_min.empty? && Gem::Version.new(pod_min) < Gem::Version.new(app_min_ios)
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = app_min_ios
        end
        # And the Mac's reading of it — see `catalyst_min_ios` above. A
        # target that inherits its minimum gets it from the project level,
        # below.
        pod_min = cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_s
        if !pod_min.empty? && Gem::Version.new(pod_min) < Gem::Version.new(catalyst_min_ios)
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET[sdk=macosx*]'] = catalyst_min_ios
        end
      end
    end
    installer.pods_project.build_configurations.each do |cfg|
      cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET[sdk=macosx*]'] = catalyst_min_ios
    end
  end
end

# Ensure Pods-PrayerApp is built before PrayerApp (fixes Swift __preview.dylib / Previews builds
# that otherwise compile the app before pod products and module maps exist).
post_integrate do |installer|
  scheme_path = File.expand_path('PrayerApp.xcodeproj/xcshareddata/xcschemes/PrayerApp.xcscheme', __dir__)
  pods_target = installer.pods_project.targets.find { |t| t.name == 'Pods-PrayerApp' }
  next unless pods_target && File.exist?(scheme_path)

  contents = File.read(scheme_path)
  updated = contents.sub(
    /BlueprintIdentifier = "[0-9A-F]{24}"(\s+BuildableName = "libPods-PrayerApp\.a")/,
    %(BlueprintIdentifier = "#{pods_target.uuid}"\\1)
  )
  File.write(scheme_path, updated) if updated != contents
end
