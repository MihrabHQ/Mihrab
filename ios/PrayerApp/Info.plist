<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The sync folder is the app's own Documents directory, and these two
	     keys are what make it reachable. UIFileSharingEnabled puts it in the
	     Files app as "On My iPhone > Mihrab"; LSSupportsOpeningDocumentsInPlace
	     lets other apps work on the files where they are rather than on
	     copies, which is what a sync client needs. Without both, the folder
	     exists and nothing else can see it. -->
	<key>NSCameraUsageDescription</key>
	<string>Mihrab uses the camera only to read the pairing code shown on your other device. Nothing is recorded or sent anywhere.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Mihrab</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Literal "Mihrab", NOT $(PRODUCT_NAME) (= "PrayerApp", the Xcode
	     target name). macOS reads CFBundleName for the menu-bar app title
	     and the About/Quit menu items, so on Mac Catalyst the menu bar
	     read "PrayerApp". CFBundleDisplayName above only covers the iOS
	     home screen. -->
	<key>CFBundleName</key>
	<string>Mihrab</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Probed by the Qibla screen to decide whether to offer "open your
	     compass app". `canOpenURL` returns false for any scheme not listed
	     here, so without this the button would never appear even on an
	     iPhone that has Compass.app. The scheme is undocumented, which is
	     exactly why it is probed rather than opened blindly. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>compass</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mihrab uses your approximate location to compute prayer times and Qibla direction for your area. Your coordinates are used with the prayer-time source you select in Settings (for example to request today’s schedule from that service). You can turn off GPS and enter coordinates or search for a place manually instead.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Mihrab uses your location only to compute prayer times and Qibla—not for advertising. Location is normally used while you use the app; if the system offers broader access for the same features, it is still limited to prayer-time and Qibla functionality. You can use manual location in Settings instead of GPS.</string>
	<key>NSMotionUsageDescription</key>
	<string>Motion is used to show the Qibla compass direction.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Mihrab saves the monthly prayer-times image you export to your photo library.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Mihrab saves the monthly prayer-times image you export to your photo library.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.hassan.prayerapp.liveactivity.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- iPhone: portrait plus both landscapes. This list is the CEILING UIKit
	     will ever grant — a screen that asks for landscape via
	     react-native-screens' `orientation` option cannot get it if the app
	     itself never declared it, which is why rotating the mushaf did
	     nothing on iPhone while it worked on iPad and Android. Every screen
	     still declares its own lock (`orientation: 'portrait'` app-wide in
	     RootNavigator), so only the readers that opt in actually rotate. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Mac Catalyst / iPad: the window is freely resizable, so all
	     orientations are supported and layouts reflow via useBreakpoint. -->
	<key>UIRequiresFullScreen</key>
	<false/>
	<!--
	The scene life cycle — REQUIRED from the iOS 27 SDK on. Without this
	key an app built with Xcode 27 does not launch on iOS/iPadOS 27 at all:
	UIKit stops it with "UIScene life cycle is required for apps built
	with this SDK". 2.25.0 to 2.27.1 shipped without it; App Review caught
	2.27.1 on an iPad Air running iPadOS 27.0.

	One scene only. The window, and the links that arrive at it, live in
	SceneDelegate (AppDelegate.swift). Guarded by __tests__/iosSceneLifecycle.test.ts.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!--
	Bundled font registration — Arabic typography.

	Drop the font files into ios/PrayerApp/Resources/fonts/ and add them
	to the Xcode project's "Copy Bundle Resources" build phase. The names
	below match the font's PostScript / family name (NOT the filename),
	which is what RN reads at runtime as `fontFamily`.

	Bundled files (permissive OFL licenses for app distribution):
	  * Amiri-Regular.ttf — https://github.com/aliftype/amiri (OFL).
	    General Arabic body text (FONTS.arabicBody).
	  * AmiriQuran.ttf — Quran ayahs (FONTS.arabicQuran).
	  * SurahNames.ttf — KFGQPC surah-name calligraphy (names only), the
	    114 glyphs direct-mapped. See src/quran/surahHeaderGlyph.ts.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>Amiri-Regular.ttf</string>
		<string>AmiriQuran.ttf</string>
		<string>SurahNames.ttf</string>
	</array>
	<!--
	mihrab:// — how a widget says WHERE it wants to be opened.

	Until this existed a widget tap landed on whatever screen the app was
	last on, which is fine for a prayer table and useless for a widget whose
	promise is "carry on from page 3". The scheme is app-private: nothing
	outside this app is expected to send it, and nothing here acts on a link
	beyond choosing a tab or a page. Route table: src/navigation/linking.ts.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mihrab</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
