+    // ── Mihrab: the joins between ayahs ─────────────────────────────────
+    //
+    // A track may carry `trimStart` / `trimEnd`: seconds of silence to skip
+    // at either end of its file. Done here and not in JS because JS timers
+    // stop when the app is in the background, and a recitation is listened
+    // to with the screen off. One coroutine per track, asleep until the
+    // moment it is needed, and only while playing: nothing here pauses the
+    // player. See src/quran/audio/seams.ts for the same on iOS.
+    private var seamJob: Job? = null
+
+    private fun Bundle?.seconds(key: String): Double? =
+        if (this != null && containsKey(key)) getDouble(key).takeIf { it > 0.0 } else null
+
+    private fun extrasAt(index: Int?): Bundle? =
+        if (index == null || !::player.isInitialized) null
+        else (player.items.getOrNull(index) as? TrackAudioItem)?.track?.originalItem
+
+    private fun watchSeam() {
+        seamJob?.cancel()
+        seamJob = null
+        if (!::player.isInitialized || !player.isPlaying) return
+        val index = player.currentIndex
+        val trimEnd = extrasAt(index).seconds("trimEnd") ?: return
+        seamJob = scope.launch {
+            while (isActive) {
+                if (player.currentIndex != index) return@launch
+                val duration = player.duration / 1000.0
+                if (duration <= 0.0) {
+                    delay(200)
+                    continue
+                }
+                if (trimEnd >= duration) return@launch
+                val left = duration - trimEnd - player.position / 1000.0
+                if (left <= 0.02) {
+                    // The last ayah of the queue ends as recorded.
+                    if (player.nextItem != null) player.next()
+                    return@launch
+                }
+                val speed = player.playbackSpeed.toDouble().coerceAtLeast(0.25)
+                delay(((left / speed) * 1000).toLong().coerceIn(15L, 1000L))
+            }
+        }
+    }
+
+    private fun onSeamTransition() {
+        if (!::player.isInitialized || player.items.isEmpty()) return
+        val trimStart = extrasAt(player.currentIndex).seconds("trimStart")
+        if (trimStart != null && player.position < trimStart * 1000 - 50) {
+            player.seek((trimStart * 1000).toLong(), TimeUnit.MILLISECONDS)
+        }
+        watchSeam()
+    }
