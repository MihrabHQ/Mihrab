+// MARK: - Mihrab: an ayah cut from a whole-surah file
+
+/// A track that is a CLIP of a longer file (`clipEnd`): an ayah cut from a
+/// whole-surah recording. It starts at its `trimStart` as it loads —
+/// SwiftAudioEx applies an initial time before a sound is played, where a
+/// seek from JS after the track change lets a moment of the surah's opening
+/// through first.
+///
+/// Its own class, so every other track loads exactly as it always has:
+/// conforming `Track` itself would have every track seek to 0 on load.
+class ClipTrack: Track, InitialTiming {
+    func getInitialTime() -> TimeInterval {
+        if let n = toObject()["trimStart"] as? NSNumber { return n.doubleValue }
+        return 0
+    }
+
+    /// A clip when the dictionary says where it ends; a plain track otherwise.
+    static func make(dictionary: [String: Any]) -> Track? {
+        if dictionary["clipEnd"] != nil { return ClipTrack(dictionary: dictionary) }
+        return Track(dictionary: dictionary)
+    }
+}
