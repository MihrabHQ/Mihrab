+  // a restart. Yoga mirrors every row, and `textAlign: 'left' | 'right'`
+  // follows (RCTResolveTextAlignment swaps them in an RTL layout) — but a
+  // Text with NO alignment is drawn with NSTextAlignmentNatural, and on iOS
+  // "natural" is the app's localization, not the layout. So in Arabic or
+  // Urdu every unaligned label sat on the LEFT of its box: titles beside
+  // the chevron instead of at the row's start, "Dhuhr in" beside the heart.
+  // Android's "natural" is the view's layout direction, so it was right.
+  //
+  // An unaligned root Text gets 'left' here, which iOS resolves against the
+  // layout direction: left in a left-to-right tree, right in a mirrored one
+  // — what natural means on Android. Nested spans are left alone; their
+  // paragraph is the root's.
+  const hasTextAncestor = useContext(TextAncestorContext);
+  if (
+    Platform.OS === 'ios' &&
+    !hasTextAncestor &&
+    (processedStyle == null ||
+      processedStyle.textAlign == null ||
+      processedStyle.textAlign === 'auto')
+  ) {
+    _style = [_style, iosLayoutStartAlign];
+  }
